# Copy to .env locally if desired.  .env is ignored by Git.
# Never commit real keys or tokens.
VECTOR_ENGINE_API_KEY=
VECTOR_ENGINE_BASE_URL=https://api.vectorengine.ai/v1

# Override these after running: python3 scripts/discover_models.py
VECTOR_QWEN35_MODEL_ID=qwen3.5-9b
VECTOR_DEEPSEEK_FLASH_MODEL_ID=deepseek-v4-flash
VECTOR_GPT4O_MINI_MODEL_ID=gpt-4o-mini
VECTOR_GEMINI_FAST_MODEL_ID=gemini-flash
VECTOR_GROK_FAST_MODEL_ID=grok-fast
VECTOR_MINIMAX_FAST_MODEL_ID=minimax-fast

# Local Flow-Director checkpoint or Hugging Face model reference.
QWEN35_9B_MODEL_PATH=Qwen/Qwen3.5-9B

# Physical cards chosen because GPU 0/1/2 were occupied during final validation.
FLOWSTEER_TRAIN_GPU=3
FLOWSTEER_INFERENCE_GPU=4
FLOWSTEER_PROBE_GPU=5
