+            if (
+                action.action_type is AgentActionType.ADD_SUBGRAPH
+                and result.execution is None
+            ):
+                raise RuntimeError(
+                    "accepted Canvas edit did not produce its required "
+                    f"execute_on_edit receipt: {result.feedback}"
