+    hotpotqa: 9
+
+paired_intervention:
+  estimand: "empty-graph Skill prompt-prior assignment intent-to-treat effect"
+  incumbent_prompt_prior: null
+  treatment_assigned_from_shared_empty_canvas: true
+  randomized_arm_order: true
+  shared_task_and_sampling_coordinates: true
+  terminal_primary_outcome: "official_answer_token_f1"
+  companion_outcome: "normalized_exact_match"
+  forced_probe: true
+  grpo_eligible: false
+  benchmark_eligible: false
+  topology_adoption_verified_by_terminal_score: false
+  exposure_admission:
+    fail_closed_before_skill_gate_or_publication: true
+    treatment_requires_preregistered_stage_exposure: true
+    incumbent_requires_zero_current_and_retained_exposure: true
+    empty_graph_requires_exact_round: 0
+  director_action_identity:
+    action_schema_version: "agentgraph.canvas-action-json-schema.v1"
+    sampling_schema_version: "agentgraph.state-conditioned-action-mask.v1"
+    sampling_action_profile: "progressive_add_subgraph_then_finish"
+    per_turn_receipt_required: true
+
+skill_gate:
+  scope: "hotpotqa_only"
+  datasets: [hotpotqa]
+  delta_min: 0.03
+  max_harm_probability: 0.05
+  minimum_effective_pairs: 20
+  minimum_empirical_coverage: 0.9
+  minimum_independent_problems: 20
+  minimum_positive_slice_fraction: 0.75
+  lower_thresholds_for_round8: false
+  activation: "delayed_until_independent_confirmation_passes"
+
+epochs:
+  discovery: 21
+  validation: 22
+  eligible_activation: 23
+discovery_schedule: "balanced cold start, posterior-UCB prefilter, then particle EVSI"
+evsi_budget:
+  ucb_prefilter_top_k: 2
+  posterior_particles: 1024
+  observation_samples: 2048
+
+data_exclusion_contract:
+  confirmation_excluded_from_grpo: true
+  confirmation_excluded_from_reported_development_and_test_metrics: true
+  final_test_untouched: true
+  reference_answer_not_visible_to_director_or_agents: true
+  supporting_fact_labels_not_visible_to_director_or_agents: true
+  native_question_type_not_visible_to_director: true
+  frozen_test_overlap_source: "manifest.json opaque ordered_task_ids.test only"
+  test_jsonl_opened_by_round8_runner: false
